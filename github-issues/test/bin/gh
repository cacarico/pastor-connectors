#!/bin/sh
# A stand-in for gh: records its arguments, one per line, in GH_ARGS (the
# last call) and as one line per call in GH_LOG, answers `api` from GH_FIXTURE
# and `pr list` from GH_PRS, and fails a call whose first two words are
# GH_FAIL, so the scripts can be checked without a GitHub login or the network.
printf '%s\n' "$@" > "$GH_ARGS"
if [ -n "${GH_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$GH_LOG"
fi
if [ -n "${GH_FAIL:-}" ] && [ "$1 ${2:-}" = "$GH_FAIL" ]; then
  echo "gh: HTTP 502: Bad Gateway" >&2
  exit 1
fi
case "$1" in
  api) cat "$GH_FIXTURE" ;;
  pr) if [ -n "${GH_PRS:-}" ]; then cat "$GH_PRS"; else echo '[]'; fi ;;
esac
